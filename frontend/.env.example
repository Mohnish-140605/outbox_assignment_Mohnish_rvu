# URL for the ReachInbox backend API.
# In development, Vite's proxy (vite.config.ts) forwards /api and /auth
# to http://localhost:4000, so JSON calls do not need this variable.
#
# Used for the full-page "Sign in with Google" redirect so the OAuth
# session cookie is set by the Express origin.
# Never put GOOGLE_CLIENT_SECRET or SESSION_SECRET here.
VITE_BACKEND_ORIGIN=http://localhost:4000

# Set this for production deployments where the proxy is not active.
# VITE_API_URL=https://your-api.example.com
