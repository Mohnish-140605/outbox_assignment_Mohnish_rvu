generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal dummy model so Prisma client can generate.
// Will be replaced by real models in future milestones.
model SystemCheck {
  id        Int      @id @default(autoincrement())
  updatedAt DateTime @updatedAt
}
