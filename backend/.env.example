PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
EMAIL_WORKER_CONCURRENCY=5

# Elasticsearch (started via docker compose up -d elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
# Optional API key for a secured remote Elasticsearch deployment (e.g. Elastic Cloud).
ELASTICSEARCH_API_KEY=

# Ethereal SMTP credentials (obtain from https://ethereal.email)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your.ethereal.user@ethereal.email
ETHEREAL_PASSWORD=your_ethereal_password

# Frontend origin allowed for credentialed CORS (no wildcards).
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth (authorization-code flow; secrets stay on the server)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized JavaScript origins (local):
#   http://localhost:5173
#   http://localhost:4000
# Authorized redirect URI (must match GOOGLE_CALLBACK_URL exactly):
#   http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Server-side session signing secret (do not reuse in the frontend).
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Slack OAuth (incoming webhook). Create a Slack app at https://api.slack.com/apps
# Enable Incoming Webhooks and OAuth. Redirect URL must match SLACK_CALLBACK_URL:
#   http://localhost:4000/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback

# Production: set NODE_ENV=production so the session cookie is Secure (HTTPS only).
# If Express sits behind a TLS-terminating reverse proxy, also set:
# TRUST_PROXY=1
